# Frontend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env

# The base URL of the deployed backend (no trailing slash).
# Development: leave empty — Vite proxy handles /api → localhost:4000
# Production:  set to your Render backend URL
VITE_API_URL=

# Google OAuth Client ID for Google Sign-In button
VITE_GOOGLE_CLIENT_ID=

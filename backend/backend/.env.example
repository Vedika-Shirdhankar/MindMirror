# Backend environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env

# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas
# Include the database name before the query string: /mindmirror?ssl=true...
MONGODB_URI=

# JWT — use a long, random string (min 32 characters)
JWT_SECRET=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS — URL of the frontend (no trailing slash)
# Development: http://localhost:5173
# Production:  https://your-vercel-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cloudinary (Required for persistent video storage in production)
CLOUDINARY_URL=cloudinary://

# Redis (optional — queue falls back to synchronous mode if not set)
REDIS_URL=redis://localhost:6379

# ── Bhashini (ULCA) — FREE Multilingual AI for Indian languages ─────────────
# Supports: Hindi, Marathi, Tamil, Telugu, Kannada, Bengali, Gujarati, Malayalam, Punjabi
# Features: Text translation (NMT), Speech-to-Text (ASR), Language detection
#
# How to get your free API keys:
#   1. Register at https://bhashini.gov.in (click "Sign Up")
#   2. Verify your email and complete your profile
#   3. Go to "My Profile" → "Generate API Key"
#   4. Copy your userId and ulcaApiKey below
#
BHASHINI_USER_ID=
BHASHINI_API_KEY=
